# AIDD Multi-Agent - Environment variables template
# Copy this to .env and fill in real keys.
# .env is in .gitignore; it will NEVER be committed.
#
# IMPORTANT: never paste real keys into chat, issues, screenshots, or code.
# Use scripts/setup_env.ps1 for safe password-style entry.

# DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# MiniMax (MiniMax) API (https://api.minimaxi.chat/user-center/basic-information/interface-key)
MiniMax_API_KEY=

# 本地 PostgreSQL 16 + RDKit cartridge + pgvector（见 docs/DATABASE_SETUP.md）
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/aidd
